# ---- Loop white-label -------------------------------------------------------
# Server pre-filled on the "configure URL" screen (host only, no scheme).
EXPO_PUBLIC_DEFAULT_INSTALLATION_HOST=loop.axioagent.app
# Comma-separated hosts treated as vendor cloud (shows SSO button / "cloud" label). Leave empty.
EXPO_PUBLIC_CLOUD_HOSTS=
# "Read docs" link in Settings → Support. Hidden when empty.
EXPO_PUBLIC_HELP_URL=
# Minimum server version the app supports (see src/utils/serverUtils.ts).
EXPO_PUBLIC_MINIMUM_CHATWOOT_VERSION=4.1.0

# ---- In-app support chat (Settings → "Chat with us"); hidden when empty ------
EXPO_PUBLIC_CHATWOOT_WEBSITE_TOKEN=
EXPO_PUBLIC_CHATWOOT_BASE_URL=

# ---- Expo / EAS ---------------------------------------------------------------
EXPO_PUBLIC_PROJECT_ID=
EXPO_PUBLIC_APP_SLUG=loop-mobile
EXPO_PUBLIC_EXPO_OWNER=
EXPO_APPLE_ID=
EXPO_APPLE_TEAM_ID=

# ---- Push (own Firebase project; files are git-ignored) ----------------------
EXPO_PUBLIC_IOS_GOOGLE_SERVICES_FILE=./GoogleService-Info.plist
EXPO_PUBLIC_ANDROID_GOOGLE_SERVICES_FILE=./google-services.json

# ---- Optional telemetry (disabled when empty) ---------------------------------
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_PROJECT_NAME=
EXPO_PUBLIC_SENTRY_ORG_NAME=
EXPO_PUBLIC_JUNE_SDK_KEY=

EXPO_STORYBOOK_ENABLED=false
